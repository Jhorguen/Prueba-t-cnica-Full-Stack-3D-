{
  "name": "site-viewer-lite",
  "version": "1.0.0",
  "private": true,
  "description": "API and web viewer for 3D scanned buildings",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "node scripts/clouds.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:e2e": "node --test e2e/viewer.e2e.js",
    "clouds": "node scripts/clouds.js --force",
    "clouds:truncate": "node scripts/clouds.js --truncate"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "express": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
